# Engine configurations for apps/uart (checked at build time, scripts/pecfg.py).
# TX: pad 16 (uo_out[0]); RX: pin 0 (ui_in[0]). 8 ticks per bit.
uart_tx_cfg  uart_tx  origin=0  out_base=16  side_base=16  tick_hz=8*VARIANT
uart_rx_cfg  uart_rx  origin=8  in_base=0    jmp_pin=0     tick_hz=8*VARIANT
