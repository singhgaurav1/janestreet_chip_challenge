; SPI controller, MSB first, 8-bit frames via autopull/autopush thresholds.
; Pins: out_base = MOSI, in_base = MISO, side_base = SCK. CS is a CPU GPIO
; (or a third engine). 4 ticks per SCK period: clkdiv = f_sys / (4 * f_sck).
; CPOL is a .define so one source covers all four modes:
;   mode 0: spi_cpha0, CPOL=0     mode 1: spi_cpha1, CPOL=0
;   mode 2: spi_cpha0, CPOL=1     mode 3: spi_cpha1, CPOL=1

.define CPOL 0

.program spi_cpha0
.side_set 1
.config out_shift_right 0
.config in_shift_right 0
.config autopull 1
.config autopush 1
.config pull_thresh 8
.config push_thresh 8
.config out_count 1
    out pins, 1     side CPOL [1]      ; data changes on the idle edge
    in pins, 1      side 1-CPOL [1]    ; sample on the active edge


.program spi_cpha1
.side_set 1
.config out_shift_right 0
.config in_shift_right 0
.config autopull 1
.config autopush 1
.config pull_thresh 8
.config push_thresh 8
.config out_count 1
    out x, 1        side CPOL          ; stall here (clock idle) until data
    mov pins, x     side 1-CPOL [1]    ; data changes on the leading edge
    in pins, 1      side CPOL          ; sample on the trailing edge
